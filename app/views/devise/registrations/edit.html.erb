<% content_for :title, "Profil bearbeiten · BrainBuster" %>

<div class="mx-auto max-w-2xl space-y-8 rounded-xl border border-slate-800 bg-slate-900/70 p-8 shadow-xl shadow-emerald-500/10">
  <header class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-white">Profil anpassen</h2>
      <p class="mt-2 text-sm text-slate-300">Aktualisiere deine Profildaten oder lade ein neues Avatarbild hoch.</p>
    </div>
    <%= avatar_for(resource, size: 64) %>
  </header>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with model: resource, url: registration_path(resource_name), method: :put, html: { multipart: true, class: "space-y-6" } do |form| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :username, "Benutzername", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
        <%= form.text_field :username, class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
      </div>
    <div>
      <%= form.label :display_name, "Anzeigename", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
      <%= form.text_field :display_name, class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <%= form.label :bio, "Über dich", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
    <%= form.text_area :bio, rows: 4, class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm leading-relaxed text-white focus:border-emerald-500 focus:outline-none" %>
    <p class="mt-1 text-xs text-slate-500">Maximal 280 Zeichen.</p>
  </div>

    <div>
      <%= form.label :email, "E-Mail", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
      <%= form.email_field :email, autocomplete: "email", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :avatar, "Profilbild", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
        <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "mt-2 w-full text-sm text-slate-300 file:mr-4 file:rounded-md file:border-0 file:bg-emerald-500 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-emerald-400" %>
        <p class="mt-1 text-xs text-slate-500">PNG, JPG oder WEBP bis 5 MB.</p>
      </div>
      <% if resource.avatar.attached? %>
        <div class="flex items-center gap-3 pt-6">
          <%= form.check_box :remove_avatar, class: "h-4 w-4 rounded border-slate-700 bg-slate-900" %>
          <%= form.label :remove_avatar, "Aktuelles Profilbild entfernen", class: "text-sm text-slate-300" %>
        </div>
      <% end %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :password, "Neues Passwort", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
        <%= form.password_field :password, autocomplete: "new-password", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none", placeholder: "Leer lassen für keine Änderung" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Passwort bestätigen", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= form.label :current_password, "Aktuelles Passwort", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
      <%= form.password_field :current_password, autocomplete: "current-password", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
      <p class="mt-1 text-xs text-slate-500">Benötigt, um Änderungen zu speichern.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit "Änderungen speichern", class: "rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" %>
      <%= link_to "Abbrechen", dashboard_path, class: "text-sm text-slate-400 hover:text-slate-200" %>
    </div>
  <% end %>

  <div class="border-t border-slate-800 pt-6 text-sm text-slate-400">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Konto löschen</h3>
    <p class="mt-2">Du möchtest BrainBuster verlassen? Dein Profil und deine Daten werden dauerhaft gelöscht.</p>
    <%= button_to "Konto entfernen", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Konto wirklich löschen?" }, class: "mt-3 rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500" %>
  </div>
</div>
