<% content_for :title, "Anmelden · BrainBuster" %>

<div class="mx-auto max-w-md rounded-xl border border-slate-800 bg-slate-900/70 p-8 shadow-2xl shadow-emerald-500/10">
  <h2 class="text-2xl font-bold text-white">Willkommen zurück</h2>
  <p class="mt-2 text-sm text-slate-300">Melde dich an, um deine Matches fortzusetzen, Punkte zu sammeln und Achievements zu jagen.</p>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with scope: resource_name, url: session_path(resource_name), class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email, "E-Mail", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Passwort", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
      <%= form.password_field :password, autocomplete: "current-password", class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center justify-between text-sm text-slate-300">
        <label class="inline-flex items-center gap-2">
          <%= form.check_box :remember_me, class: "h-4 w-4 rounded border-slate-700 bg-slate-900" %>
          <span>Angemeldet bleiben</span>
        </label>
        <%= link_to "Passwort vergessen?", new_password_path(resource_name), class: "text-emerald-400 hover:text-emerald-300" %>
      </div>
    <% end %>

    <div class="pt-2">
      <%= form.submit "Anmelden", class: "w-full rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" %>
    </div>
  <% end %>

  <div class="mt-6 text-center text-sm text-slate-400">
    <span>Neu hier?</span>
    <%= link_to "Jetzt registrieren", new_user_registration_path, class: "ml-1 text-emerald-400 hover:text-emerald-300" %>
  </div>
</div>
