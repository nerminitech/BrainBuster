<section class="space-y-6">
  <header class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <h2 class="text-3xl font-bold text-white">Kategorien verwalten</h2>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Neue Kategorie", new_admin_category_path, class: "rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" %>
      <%= button_to "Seed-Daten laden", admin_seed_path,
                    method: :post,
                    data: { turbo_confirm: "Seed-Daten wirklich laden? Bereits vorhandene Inhalte werden aktualisiert." },
                    class: "rounded-lg bg-blue-500 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-400" %>
    </div>
  </header>

  <table class="w-full table-fixed rounded-xl border border-slate-800 bg-slate-900/60 text-sm text-slate-200">
    <thead class="text-xs uppercase tracking-wide text-slate-400">
      <tr>
        <th class="px-4 py-3 text-left">Name</th>
        <th class="px-4 py-3 text-left">Fragen</th>
        <th class="px-4 py-3 text-left">Featured</th>
        <th class="px-4 py-3 text-right">Aktionen</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-t border-slate-800/60">
          <td class="px-4 py-3 font-semibold text-white"><%= category.name %></td>
          <td class="px-4 py-3"><%= category.questions.count %></td>
          <td class="px-4 py-3"><%= category.featured? ? "Ja" : "Nein" %></td>
          <td class="px-4 py-3 text-right space-x-2">
            <%= link_to "Anzeigen", admin_category_path(category), class: "text-xs font-semibold text-emerald-300 hover:text-emerald-200" %>
            <%= link_to "Bearbeiten", edit_admin_category_path(category), class: "text-xs font-semibold text-blue-300 hover:text-blue-200" %>
            <%= link_to "Löschen", admin_category_path(category), data: { turbo_method: :delete, turbo_confirm: "Kategorie wirklich löschen?" }, class: "text-xs font-semibold text-rose-300 hover:text-rose-200" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
