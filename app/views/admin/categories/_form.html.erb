<%= form_with model: [:admin, @category], class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, "Name", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
    <%= form.text_field :name, class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500" %>
  </div>
  <div>
    <%= form.label :description, "Beschreibung", class: "block text-xs font-semibold uppercase tracking-wide text-slate-400" %>
    <%= form.text_area :description, rows: 4, class: "mt-2 w-full rounded-md border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500" %>
  </div>
  <div class="flex items-center gap-2 text-sm text-slate-300">
    <%= form.check_box :featured, class: "h-4 w-4 rounded border-slate-700 bg-slate-900" %>
    <%= form.label :featured, "Kategorie hervorheben" %>
  </div>
  <div class="flex items-center gap-3">
    <%= form.submit "Kategorie erstellen", class: "rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" %>
    <%= link_to "Abbrechen", admin_categories_path, class: "text-sm text-slate-400 hover:text-slate-200" %>
  </div>
<% end %>
