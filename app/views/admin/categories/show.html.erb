<section class="space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-xs text-slate-400"><%= link_to "Zurück", admin_categories_path, class: "hover:text-slate-200" %></p>
      <h2 class="text-3xl font-bold text-white"><%= @category.name %></h2>
    </div>
    <div class="flex gap-3 text-sm">
      <%= link_to "Bearbeiten", edit_admin_category_path(@category), class: "rounded-md border border-slate-700 px-4 py-2 font-semibold text-slate-200 hover:bg-slate-800" %>
      <%= link_to "Löschen", admin_category_path(@category), data: { turbo_method: :delete, turbo_confirm: "Kategorie wirklich löschen?" }, class: "rounded-md bg-rose-500 px-4 py-2 font-semibold text-white hover:bg-rose-400" %>
    </div>
  </header>

  <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 text-sm text-slate-200">
    <p class="text-slate-300"><%= simple_format(@category.description) %></p>
    <p class="mt-4 text-xs text-slate-500">Status: <%= @category.featured? ? "Hervorgehoben" : "Standard" %></p>
  </article>

  <section>
    <h3 class="text-xl font-semibold text-white">Fragen</h3>
    <ul class="mt-4 space-y-3 text-sm">
      <% @questions.each do |question| %>
        <li class="rounded-lg border border-slate-800 bg-slate-900/50 px-4 py-3">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-white"><%= truncate(question.content, length: 90) %></p>
            <%= link_to "Bearbeiten", edit_admin_question_path(question), class: "text-xs font-semibold text-blue-300 hover:text-blue-200" %>
          </div>
          <p class="mt-1 text-xs text-slate-400"><%= question.answer_options.count %> Antwortoptionen · Schwierigkeitsgrad <%= question.difficulty %></p>
        </li>
      <% end %>
    </ul>
  </section>
</section>
