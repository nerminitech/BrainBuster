<section class="space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-xs text-slate-400"><%= link_to "Zurück", admin_questions_path, class: "hover:text-slate-200" %></p>
      <h2 class="text-3xl font-bold text-white"><%= truncate(@question.content, length: 120) %></h2>
    </div>
    <div class="flex gap-3 text-sm">
      <%= link_to "Bearbeiten", edit_admin_question_path(@question), class: "rounded-md border border-slate-700 px-4 py-2 font-semibold text-slate-200 hover:bg-slate-800" %>
      <%= link_to "Löschen", admin_question_path(@question), data: { turbo_method: :delete, turbo_confirm: "Frage wirklich löschen?" }, class: "rounded-md bg-rose-500 px-4 py-2 font-semibold text-white hover:bg-rose-400" %>
    </div>
  </header>

  <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 text-sm text-slate-200">
    <p><strong>Kategorie:</strong> <%= @question.category.name %></p>
    <p class="mt-2"><strong>Schwierigkeit:</strong> <%= @question.difficulty %></p>
    <p class="mt-2"><strong>Zeitlimit:</strong> <%= @question.time_limit_seconds %> Sekunden</p>
    <p class="mt-2"><strong>Basis-Punkte:</strong> <%= @question.base_points %></p>
    <% if @question.source_url.present? %>
      <% source_url = @question.source_url.gsub(/[^\w\-\.:\/?&=%+]/, "") %>
      <p class="mt-2"><strong>Quelle:</strong> <%= link_to source_url, source_url, class: "text-emerald-300 hover:text-emerald-200", rel: "noopener", target: "_blank" %></p>
    <% end %>
    <% if @question.explanation.present? %>
      <p class="mt-4 text-slate-300"><strong>Erklärung:</strong> <%= @question.explanation %></p>
    <% end %>
  </article>

  <section>
    <h3 class="text-xl font-semibold text-white">Antwortoptionen</h3>
    <ul class="mt-4 space-y-3 text-sm">
      <% @question.answer_options.each do |option| %>
        <li class="rounded-lg border border-slate-800 bg-slate-900/50 px-4 py-3 <%= option.correct? ? 'border-emerald-600 bg-emerald-500/10' : '' %>">
          <div class="flex items-center justify-between">
            <span class="text-white"><%= option.text %></span>
            <% if option.correct? %>
              <span class="rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-200">Korrekte Antwort</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
</section>
