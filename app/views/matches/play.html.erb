<% content_for :title, @match.versus? ? "Match ##{@match.share_code} · Frage #{@match_question.position + 1}" : "Match · Frage #{@match_question.position + 1}" %>

<section class="space-y-6" data-controller="countdown" data-countdown-remaining-value="<%= @time_remaining_seconds %>" data-countdown-deadline-value="<%= @question_deadline_epoch_ms %>" data-countdown-server-time-value="<%= @server_time_epoch_ms %>">
  <header class="flex items-center justify-between">
    <div>
      <% if @match.versus? %>
        <p class="text-xs text-slate-400">Match-Code: <span class="font-mono text-emerald-300"><%= @match.share_code %></span></p>
      <% end %>
      <h2 class="text-2xl font-bold text-white">Frage <%= @match_question.position + 1 %> von <%= @match.question_count %></h2>
      <p class="mt-1 text-xs text-slate-400">⏱ <%= @match.time_per_question %> Sekunden · Kategorie <%= @match.category.name %></p>
    </div>
    <div class="flex flex-col items-end gap-3 text-right text-sm text-slate-300">
      <p>Punktestand: <span class="font-semibold text-emerald-400"><%= @participation.score %></span></p>
      <p>Richtig beantwortet: <%= @participation.correct_count %></p>
      <div class="inline-flex flex-col items-end">
        <span class="text-xs uppercase tracking-wide text-slate-500">Verbleibende Zeit</span>
        <span class="font-mono text-emerald-300 text-4xl font-bold leading-none drop-shadow-lg" data-countdown-target="display"><%= @time_remaining_seconds %>s</span>
      </div>
      <% if @participation.playing? %>
        <%= button_to "Match abbrechen",
                      forfeit_match_path(@match),
                      method: :post,
                      data: { turbo_confirm: "Willst du dieses Match wirklich abbrechen? Dein Fortschritt geht verloren." },
                      class: "rounded-lg bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-rose-500" %>
      <% end %>
    </div>
  </header>

  <% if @match.versus? %>
    <div
      class="rounded-2xl border border-emerald-500/50 bg-emerald-500/10 p-5 text-center shadow-lg shadow-emerald-500/20"
      data-controller="clipboard"
      data-clipboard-text-value="<%= @match.share_code %>"
    >
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-200">Mit Freundinnen und Freunden spielen</p>
      <div class="mt-3 flex flex-col items-center gap-3 md:flex-row md:justify-center">
        <span class="rounded-xl border border-emerald-400/60 bg-slate-950 px-5 py-2 font-mono text-xl font-semibold tracking-widest text-emerald-300 shadow-inner shadow-emerald-500/20">
          <%= @match.share_code %>
        </span>
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-400"
          data-action="click->clipboard#copy"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 13.5H7.8A2.8 2.8 0 0 1 5 10.7V7.8A2.8 2.8 0 0 1 7.8 5h2.9" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="9" y="5" width="10" height="14" rx="2" ry="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Code kopieren
        </button>
      </div>
      <p class="mt-3 text-xs text-emerald-100">Einfach weiterleiten, damit andere unter „Match-Code eingeben” beitreten.</p>
      <span data-clipboard-target="feedback" class="mt-2 block text-xs font-semibold text-emerald-200 hidden"></span>
    </div>
  <% end %>

  <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <%= difficulty_badge(@current_question.difficulty) %>
      <span class="text-xs text-slate-400">Verbleibende Fragen: <%= @match.question_count - @positions_answered %></span>
    </div>
    <h3 class="mt-4 text-xl font-semibold text-white"><%= @current_question.content %></h3>
    <%# Hinweis bewusst ausgeblendet %>

    <%= form_with url: match_attempts_path(@match), method: :post, data: { countdown_target: "form" }, class: "mt-6 space-y-3" do |form| %>
      <%= hidden_field_tag :match_question_id, @match_question.id %>
      <div class="grid gap-3">
        <% @current_question.answer_options.each do |option| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-800 bg-slate-950 px-4 py-3 text-sm text-white hover:border-emerald-500">
            <%= form.radio_button :answer_option_id, option.id %>
            <span><%= option.text %></span>
          </label>
        <% end %>
      </div>
      <div class="flex justify-end gap-3">
        <%= form.submit "Antwort abschicken", class: "rounded-lg bg-emerald-500 px-5 py-2 text-sm font-semibold text-white transition transform-gpu hover:-translate-y-0.5 hover:bg-emerald-400 hover:shadow-lg hover:shadow-emerald-500/30 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-slate-950 cursor-pointer" %>
      </div>
    <% end %>
  </article>
</section>
