<% content_for :title, "Match ##{@match.share_code} · Frage #{@match_question.position + 1}" %>

<section class="space-y-6" data-controller="countdown" data-countdown-remaining-value="<%= @time_remaining_seconds %>" data-countdown-deadline-value="<%= @question_deadline_epoch_ms %>">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-xs text-slate-400">Match-Code: <span class="font-mono text-emerald-300"><%= @match.share_code %></span></p>
      <h2 class="text-2xl font-bold text-white">Frage <%= @match_question.position + 1 %> von <%= @match.question_count %></h2>
      <p class="mt-1 text-xs text-slate-400">⏱ <%= @match.time_per_question %> Sekunden · Kategorie <%= @match.category.name %></p>
    </div>
    <div class="text-right text-sm text-slate-300 space-y-1">
      <p>Punktestand: <span class="font-semibold text-emerald-400"><%= @participation.score %></span></p>
      <p>Richtig beantwortet: <%= @participation.correct_count %></p>
      <p class="text-xs text-slate-400">Verbleibende Zeit: <span class="font-mono text-emerald-300" data-countdown-target="display"><%= @time_remaining_seconds %>s</span></p>
    </div>
  </header>

  <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <%= difficulty_badge(@current_question.difficulty) %>
      <span class="text-xs text-slate-400">Verbleibende Fragen: <%= @match.question_count - @positions_answered %></span>
    </div>
    <h3 class="mt-4 text-xl font-semibold text-white"><%= @current_question.content %></h3>
    <%# Hinweis bewusst ausgeblendet %>

    <%= form_with url: match_attempts_path(@match), method: :post, data: { countdown_target: "form" }, class: "mt-6 space-y-3" do |form| %>
      <%= hidden_field_tag :match_question_id, @match_question.id %>
      <div class="grid gap-3">
        <% @current_question.answer_options.each do |option| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-800 bg-slate-950 px-4 py-3 text-sm text-white hover:border-emerald-500">
            <%= form.radio_button :answer_option_id, option.id %>
            <span><%= option.text %></span>
          </label>
        <% end %>
      </div>
      <div class="flex justify-end gap-3">
        <%= form.submit "Antwort abschicken", class: "rounded-lg bg-emerald-500 px-5 py-2 text-sm font-semibold text-white transition transform-gpu hover:-translate-y-0.5 hover:bg-emerald-400 hover:shadow-lg hover:shadow-emerald-500/30 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-slate-950 cursor-pointer" %>
      </div>
    <% end %>
  </article>
</section>
