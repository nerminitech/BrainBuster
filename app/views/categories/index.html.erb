<section class="space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <h2 class="text-3xl font-bold text-white">Kategorien</h2>
      <p class="mt-1 text-sm text-slate-300">Wähle eine Kategorie, um Fragen anzusehen oder ein Quiz zu starten.</p>
    </div>
    <%= link_to "Quiz starten", new_match_path, class: "rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-400" if user_signed_in? %>
  </header>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @categories.each do |category| %>
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <div class="flex items-start justify-between">
          <h3 class="text-xl font-semibold text-white"><%= category.name %></h3>
          <% if category.featured? %>
            <span class="rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-300">Empfohlen</span>
          <% end %>
        </div>
        <p class="mt-3 text-sm text-slate-400"><%= truncate(category.description.to_s, length: 140) %></p>
        <div class="mt-4 flex items-center justify-between text-xs text-slate-400">
          <span><%= pluralize(category.questions.count, "Frage", "Fragen") %></span>
          <%= link_to "Details", category_path(category), class: "font-semibold text-emerald-300 hover:text-emerald-200" %>
        </div>
      </div>
    <% end %>
  </div>
</section>
