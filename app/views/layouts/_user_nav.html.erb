<% if user.present? %>
  <%= link_to profile_path, class: "group flex items-center gap-3" do %>
    <%= avatar_for(user, size: 40, classes: "ring-2 ring-transparent transition group-hover:ring-emerald-400/60") %>
    <div class="hidden text-left md:block">
      <p class="text-sm font-semibold text-white transition group-hover:text-emerald-300"><%= truncate(user.display_name, length: 20) %></p>
    </div>
  <% end %>
  <%= button_to "Abmelden", destroy_user_session_path, method: :delete,
                form: { class: "contents" },
                class: "rounded-md bg-red-500 px-3 py-1 font-semibold text-white transition hover:bg-red-400" %>
<% else %>
  <%= link_to "Registrieren", new_user_registration_path, class: "rounded-md bg-emerald-500 px-3 py-1 font-semibold text-white transition hover:bg-emerald-400" %>
  <%= link_to "Anmelden", new_user_session_path, class: "rounded-md border border-slate-700 px-3 py-1 font-semibold text-slate-200 transition hover:bg-slate-800" %>
<% end %>
