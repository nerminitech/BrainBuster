<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BrainBuster" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <div class="min-h-screen flex flex-col">
      <header class="border-b border-slate-800 bg-slate-900/70 backdrop-blur">
        <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
          <%= link_to "BrainBuster", dashboard_path, class: "text-xl font-bold tracking-tight" %>
          <nav class="flex items-center gap-4 text-sm font-medium text-slate-200">
            <%= link_to "Dashboard", dashboard_path, class: nav_link_classes(dashboard_path) %>
            <%= link_to "Quiz erstellen", new_match_path, class: nav_link_classes(new_match_path) %>
            <%= link_to "Matches", matches_path, class: nav_link_classes(matches_path) %>
            <%= link_to "Rangliste", leaderboards_path, class: nav_link_classes(leaderboards_path) %>
            <%= link_to "Achievements", achievements_path, class: nav_link_classes(achievements_path) %>
            <% if current_user&.admin? %>
              <%= link_to "Admin", admin_categories_path, class: nav_link_classes(admin_categories_path) %>
            <% end %>
          </nav>
          <div class="flex items-center gap-3 text-sm">
            <% if user_signed_in? %>
              <span class="hidden md:block text-slate-300">Hallo, <%= current_user.display_name %></span>
              <%= button_to "Abmelden", destroy_user_session_path, method: :delete, class: "rounded-md bg-red-500 px-3 py-1 font-semibold text-white transition hover:bg-red-400" %>
            <% else %>
              <%= link_to "Registrieren", new_user_registration_path, class: "rounded-md bg-emerald-500 px-3 py-1 font-semibold text-white transition hover:bg-emerald-400" %>
              <%= link_to "Anmelden", new_user_session_path, class: "rounded-md border border-slate-700 px-3 py-1 font-semibold text-slate-200 transition hover:bg-slate-800" %>
            <% end %>
          </div>
        </div>
      </header>

      <main class="flex-1">
        <div class="mx-auto w-full max-w-6xl px-6 py-10">
          <% flash.each do |type, message| %>
            <div class="mb-4 rounded-md border border-slate-700 bg-slate-900/70 px-4 py-3 text-sm text-slate-100">
              <%= message %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </main>

      <footer class="border-t border-slate-800 bg-slate-900/60">
        <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6 text-xs text-slate-400">
          <span>&copy; <%= Time.current.year %> BrainBuster</span>
          <nav class="flex items-center gap-4">
            <%= link_to "Hilfe", help_path, class: "hover:text-slate-200" %>
            <%= link_to "Kategorien", categories_path, class: "hover:text-slate-200" %>
            <span>Punkte insgesamt: <%= current_user&.total_points || 0 %></span>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
