<!DOCTYPE html>
<html>
  <head>
    <!-- Grundlegende Seiteneinstellungen und Sicherheits-Tags -->
    <title><%= content_for(:title) || "BrainBuster" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="flex flex-col min-h-screen">
      <!-- Oberer Navigationsbereich mit Links und Benutzerinfo -->
      <header class="border-b backdrop-blur border-slate-800 bg-slate-900/70">
        <div class="flex justify-between items-center px-6 py-4 mx-auto w-full max-w-6xl">
          <%= link_to "BrainBuster", dashboard_path, class: "text-xl font-bold tracking-tight" %>
          <nav class="flex gap-4 items-center text-sm font-medium text-slate-200">
            <%= link_to "Dashboard", dashboard_path, class: nav_link_classes(dashboard_path) %>
            <%= link_to "Quiz starten", new_match_path, class: nav_link_classes(new_match_path) %>
            <%= link_to "Matches", matches_path, class: nav_link_classes(matches_path) %>
            <%= link_to "Rangliste", leaderboards_path, class: nav_link_classes(leaderboards_path) %>
            <%= link_to "Achievements", achievements_path, class: nav_link_classes(achievements_path) %>
            <% if current_user&.admin? %>
              <%= link_to "Admin", admin_categories_path, class: nav_link_classes(admin_categories_path) %>
            <% end %>
          </nav>
          <div class="text-sm">
            <turbo-frame id="user_nav" class="flex gap-3 items-center">
              <%= render "layouts/user_nav", user: current_user %>
            </turbo-frame>
          </div>
        </div>
      </header>

      <!-- Hauptbereich fuer die wechselnden Seiteninhalte -->
      <main class="flex-1">
        <div class="px-6 py-10 mx-auto w-full max-w-6xl">
          <turbo-frame id="flash_messages">
            <%= render "shared/flash" %>
          </turbo-frame>
          <%= yield %>
        </div>
      </main>

      <!-- Fussbereich mit einer kurzen Kennzahl -->
      <footer class="border-t border-slate-800 bg-slate-900/60">
        <div class="flex justify-between items-center px-6 py-6 mx-auto w-full max-w-6xl text-xs text-slate-400">
          <span>Von Team 11</span>
          <nav class="flex gap-4 items-center">
            <span>Punkte insgesamt: <%= current_user&.total_points || 0 %></span>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
