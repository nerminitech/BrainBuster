<% content_for :title, "Profil · #{@user.display_name}" %>

<div class="mx-auto space-y-8 max-w-5xl">
  <div>
    <%= render "profiles/overview", user: @user %>
  </div>

  <div class="grid gap-6 lg:grid-cols-[2fr,1fr]">
    <section class="space-y-6">
      <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-6">
        <h2 class="text-lg font-semibold text-white">Erfolge</h2>
        <% if @recent_achievements.any? %>
          <ul class="mt-4 space-y-3 text-sm">
            <% @recent_achievements.each do |ua| %>
              <li class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-900/50 px-4 py-3">
                <div>
                  <p class="font-semibold text-emerald-300"><%= ua.achievement.name %></p>
                  <p class="text-xs text-slate-400"><%= ua.achievement.description %></p>
                </div>
                <span class="text-xs text-slate-500"><%= l ua.awarded_at, format: :short %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm text-slate-400">Noch keine Achievements freigeschaltet.</p>
        <% end %>
        <div class="mt-4">
          <%= link_to "Alle Achievements ansehen", achievements_path, class: "text-xs font-semibold text-emerald-400 hover:text-emerald-300" %>
        </div>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-6">
        <h2 class="text-lg font-semibold text-white">Zuletzt gespielte Matches</h2>
        <% if @recent_participations.any? %>
          <ul class="mt-4 space-y-3 text-sm">
            <% @recent_participations.each do |participation| %>
              <li class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-900/50 px-4 py-3">
                <div>
                  <p class="font-semibold text-white"><%= participation.match.title || participation.match.category.name %></p>
                  <p class="text-xs text-slate-400">
                    <%= participation.status == "forfeited" ? "Abgebrochen" : "Abgeschlossen" %>
                    · <%= l(participation.completed_at, format: :short) if participation.completed_at.present? %>
                  </p>
                </div>
                <span class="text-xs text-emerald-300 font-semibold">+<%= participation.score %> Punkte</span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm text-slate-400">Noch keine Matches absolviert.</p>
        <% end %>
      </div>
    </section>

    <aside class="space-y-4">
      <div class="p-6 text-sm rounded-xl border border-slate-800 bg-slate-900/70 text-slate-300">
        <h2 class="text-sm font-semibold tracking-wide uppercase text-slate-500">Profil</h2>
        <dl class="mt-4 space-y-3">
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Rolle</dt>
            <dd class="font-medium text-white"><%= @user.role.titleize %></dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Matches gespielt</dt>
            <dd class="font-medium text-white"><%= @user.completed_matches %></dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Aktuelle Serie</dt>
            <dd class="font-medium text-white"><%= @user.daily_streak %> Tage</dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Achievements</dt>
            <dd class="font-medium text-white"><%= @user.achievements_count %></dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</div>
