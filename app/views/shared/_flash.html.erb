<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <% variant = type.to_sym %>
  <% css = case variant
          when :success
            "border-l-4 border-emerald-400 bg-emerald-500/10 text-emerald-50 shadow-lg ring-1 ring-emerald-400/40"
          when :warning, :alert
            "border-l-4 border-amber-400 bg-amber-500/10 text-amber-50 shadow-lg ring-1 ring-amber-400/40"
          when :error
            "border-l-4 border-rose-400 bg-rose-500/10 text-rose-50 shadow-lg ring-1 ring-rose-400/40"
          else
            "border-l-4 border-slate-400 bg-slate-800 text-slate-100 shadow-lg ring-1 ring-slate-500/30"
          end %>
  <% label = case variant
            when :success then "Erfolg"
            when :warning, :alert then "Hinweis"
            when :error then "Fehler"
            else "Info"
            end %>

  <div class="relative mb-4 flex items-start gap-3 overflow-hidden rounded-2xl px-5 py-4 text-sm font-semibold leading-5 transition-transform duration-300 ease-out <%= css %>" role="status">
    <span class="mt-1 inline-flex h-3 w-3 flex-none animate-ping rounded-full bg-current opacity-80"></span>
    <div class="flex flex-col gap-1">
      <span class="text-xs uppercase tracking-wide opacity-90"><%= label %></span>
      <span class="text-base font-medium leading-6"><%= message %></span>
    </div>
  </div>
<% end %>
