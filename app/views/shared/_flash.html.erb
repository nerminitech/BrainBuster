<!-- Geht alle Flash-Nachrichten durch, die Rails fuer diese Seite bereithält -->
<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <% variant = type.to_sym %>
  <!-- Sorgt dafuer, dass jede Nachricht passende Farben, Icons und Texte bekommt -->
  <% base_classes, icon_wrapper_classes, label = case variant
          when :success
            [
              "bg-gradient-to-r from-emerald-500 to-emerald-400 text-white shadow-2xl ring-2 ring-emerald-200/70",
              "bg-white/15 text-white",
              "Erfolg"
            ]    
          when :warning, :alert
            [
              "bg-gradient-to-r from-amber-500 to-amber-400 text-white shadow-2xl ring-2 ring-amber-200/70",
              "bg-white/15 text-white",
              "Hinweis"
            ]
          when :error
            [
              "bg-gradient-to-r from-rose-600 to-rose-500 text-white shadow-2xl ring-2 ring-rose-200/70",
              "bg-white/15 text-white",
              "Fehler"
            ]
          when :achievement
            [
              "bg-gradient-to-r from-fuchsia-500 via-violet-500 to-indigo-500 text-white shadow-2xl ring-2 ring-violet-200/70",
              "bg-white/15 text-white",
              "Achievement"
            ]
          else
            [
              "bg-gradient-to-r from-slate-800 to-slate-700 text-slate-100 shadow-2xl ring-2 ring-slate-400/60",
              "bg-white/10 text-slate-100",
              "Info"
            ]
          end %>

  <!-- Waehlt das richtige Symbol entsprechend des Nachrichtentyps -->
  <% icon_svg = case variant
          when :success
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              tag.path(d: "M5 13l4 4L19 7", stroke_linecap: "round", stroke_linejoin: "round")
            end
          when :warning, :alert
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.path(d: "M12 9v4", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M12 17h.01", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M10.29 3.86L1.82 18a1 1 0 00.86 1.5h18.64a1 1 0 00.86-1.5L13.71 3.86a1 1 0 00-1.72 0z", stroke_linecap: "round", stroke_linejoin: "round")
              ])
            end
          when :error
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.path(d: "M6 18L18 6", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M6 6l12 12", stroke_linecap: "round", stroke_linejoin: "round")
              ])
            end
          when :achievement
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.path(d: "M8 21h8", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M12 17v4", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M7 4h10v6a5 5 0 01-10 0V4z", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M7 4l-2 3v2h2", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M17 4l2 3v2h-2", stroke_linecap: "round", stroke_linejoin: "round")
              ])
            end
          else
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.circle(cx: 12, cy: 12, r: 9),
                tag.line(x1: 12, y1: 8, x2: 12, y2: 12, stroke_linecap: "round"),
                tag.circle(cx: 12, cy: 16, r: 0.5, fill: "currentColor")
              ])
            end
          end %>

  <!-- Die eigentliche Box, die auf der Seite angezeigt wird -->
  <div data-controller="flash" class="relative mb-4 flex justify-end">
    <div data-flash-target="container" class="flex w-full items-center gap-4 overflow-hidden rounded-3xl border border-white/10 px-6 py-5 text-base font-semibold leading-6 backdrop-blur-sm transform transition-all duration-300 ease-out translate-x-6 opacity-0 <%= base_classes %>" role="alert" aria-live="assertive">
      <div class="flex h-12 w-12 flex-none items-center justify-center rounded-full shadow-md <%= icon_wrapper_classes %>">
      <%= icon_svg %>
      </div>
      <div class="flex flex-1 flex-col gap-2 text-left">
        <span class="text-xs font-bold uppercase tracking-[0.2em] opacity-90"><%= label %></span>
        <% if variant == :achievement %>
          <div class="space-y-3">
            <% Array(message).each do |entry| %>
              <% item = entry.respond_to?(:symbolize_keys) ? entry.symbolize_keys : entry %>
              <div class="rounded-xl bg-white/10 p-3 shadow-inner">
                <p class="text-[0.75rem] font-semibold uppercase tracking-wide text-amber-200"><%= item[:code].to_s.tr("_", " ").capitalize %></p>
                <p class="text-lg font-semibold"><%= item[:name] %></p>
                <p class="text-sm font-medium text-violet-100/85"><%= item[:description] %></p>
                <% if item[:points].to_i.positive? %>
                  <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-emerald-200">+<%= item[:points] %> Punkte</p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <span class="text-lg font-semibold"><%= message %></span>
        <% end %>
      </div>
      <button type="button" class="text-xl font-bold text-white/70 transition hover:text-white" data-action="flash#close">×</button>
    </div>
  </div>
<% end %>
