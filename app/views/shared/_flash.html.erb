<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <% variant = type.to_sym %>
  <% base_classes, icon_wrapper_classes, label = case variant
          when :success
            [
              "bg-gradient-to-r from-emerald-500 to-emerald-400 text-white shadow-2xl ring-2 ring-emerald-200/70",
              "bg-white/15 text-white",
              "Erfolg"
            ]    
          when :warning, :alert
            [
              "bg-gradient-to-r from-amber-500 to-amber-400 text-white shadow-2xl ring-2 ring-amber-200/70",
              "bg-white/15 text-white",
              "Hinweis"
            ]
          when :error
            [
              "bg-gradient-to-r from-rose-600 to-rose-500 text-white shadow-2xl ring-2 ring-rose-200/70",
              "bg-white/15 text-white",
              "Fehler"
            ]
          else
            [
              "bg-gradient-to-r from-slate-800 to-slate-700 text-slate-100 shadow-2xl ring-2 ring-slate-400/60",
              "bg-white/10 text-slate-100",
              "Info"
            ]
          end %>

  <% icon_svg = case variant
          when :success
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              tag.path(d: "M5 13l4 4L19 7", stroke_linecap: "round", stroke_linejoin: "round")
            end
          when :warning, :alert
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.path(d: "M12 9v4", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M12 17h.01", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M10.29 3.86L1.82 18a1 1 0 00.86 1.5h18.64a1 1 0 00.86-1.5L13.71 3.86a1 1 0 00-1.72 0z", stroke_linecap: "round", stroke_linejoin: "round")
              ])
            end
          when :error
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.path(d: "M6 18L18 6", stroke_linecap: "round", stroke_linejoin: "round"),
                tag.path(d: "M6 6l12 12", stroke_linecap: "round", stroke_linejoin: "round")
              ])
            end
          else
            tag.svg(xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", stroke_width: 2, class: "h-6 w-6") do
              safe_join([
                tag.circle(cx: 12, cy: 12, r: 9),
                tag.line(x1: 12, y1: 8, x2: 12, y2: 12, stroke_linecap: "round"),
                tag.circle(cx: 12, cy: 16, r: 0.5, fill: "currentColor")
              ])
            end
          end %>

  <div class="relative mb-6 flex items-center gap-4 overflow-hidden rounded-3xl border border-white/10 px-6 py-5 text-base font-semibold leading-6 backdrop-blur-sm transition-transform duration-300 ease-out <%= base_classes %>" role="alert" aria-live="assertive">
    <div class="flex h-12 w-12 flex-none items-center justify-center rounded-full shadow-md <%= icon_wrapper_classes %>">
      <%= icon_svg %>
    </div>
    <div class="flex flex-col gap-1 text-left">
      <span class="text-xs font-bold uppercase tracking-[0.2em] opacity-90"><%= label %></span>
      <span class="text-lg font-semibold"><%= message %></span>
    </div>
  </div>
<% end %>
