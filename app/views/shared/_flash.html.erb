<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% css = case type.to_sym
          when :success
            "border-emerald-700 bg-emerald-900/40 text-emerald-100"
          when :warning, :alert
            "border-amber-700 bg-amber-900/40 text-amber-100"
          when :error
            "border-rose-700 bg-rose-900/40 text-rose-100"
          else
            "border-slate-700 bg-slate-900/70 text-slate-100"
          end %>
  <div class="mb-4 rounded-md border px-4 py-3 text-sm <%= css %>">
    <%= message %>
  </div>
<% end %>
