<% content_for :title, "Dein Profil · BrainBuster" %>

<div class="mx-auto space-y-8 max-w-5xl">
  <turbo-frame id="profile_overview">
    <%= render "overview", user: @user %>
  </turbo-frame>

  <div class="grid gap-6 lg:grid-cols-[2fr,1fr]">
    <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/70">
      <h2 class="text-lg font-semibold text-white">Profil anpassen</h2>
      <p class="mt-1 text-sm text-slate-400">Passe deinen Anzeigenamen, deine Bio oder dein Profilbild an. Alle Anpassungen werden sofort mit Hotwire aktualisiert.</p>
      <div class="mt-6">
        <turbo-frame id="profile_form">
          <%= render "form", user: @user %>
        </turbo-frame>
      </div>
    </div>

    <div class="space-y-4">
      <div class="p-6 text-sm rounded-xl border border-slate-800 bg-slate-900/70 text-slate-300">
        <h2 class="text-sm font-semibold tracking-wide uppercase text-slate-500">Kontodaten</h2>
        <dl class="mt-4 space-y-3">
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">E-Mail</dt>
            <dd class="font-medium text-white"><%= @user.email %></dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Rolle</dt>
            <dd class="font-medium text-white"><%= @user.role.titleize %></dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Matches gespielt</dt>
            <dd class="font-medium text-white"><%= @user.completed_matches %></dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-slate-400">Aktuelle Serie</dt>
            <dd class="font-medium text-white"><%= @user.daily_streak %> Tage</dd>
          </div>
        </dl>
      </div>

      <div class="p-6 text-sm rounded-xl border border-slate-800 bg-slate-900/70 text-slate-300">
        <h2 class="text-sm font-semibold tracking-wide uppercase text-slate-500">Schnellaktionen</h2>
        <ul class="mt-4 space-y-3">
          <li><%= link_to "Profil bearbeiten", edit_user_registration_path, class: "text-emerald-400 hover:text-emerald-300" %></li>
          <li><%= link_to "Matches erstellen", new_match_path, class: "text-emerald-400 hover:text-emerald-300" %></li>
          <li><%= link_to "Achievements ansehen", achievements_path, class: "text-emerald-400 hover:text-emerald-300" %></li>
        </ul>
      </div>
    </div>
  </div>
</div>
